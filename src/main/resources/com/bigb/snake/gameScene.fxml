<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<?import com.bigb.snake.GameArea?>

<VBox fx:controller="com.bigb.snake.GameController" fx:id="gameRoot" alignment="CENTER"
  spacing="3.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1">

  <children>
    <VBox alignment="CENTER" spacing="3.0">
      <children>
        <Label text="Timer" />
        <Label fx:id="gameTime" />
      </children>
    </VBox>
    <GameArea fx:id="gameArea" />
    <GridPane>
      <padding>
        <Insets topRightBottomLeft="5"/>
      </padding>
      <columnConstraints>
        <ColumnConstraints percentWidth="20.0" />
        <ColumnConstraints percentWidth="20.0" />
        <ColumnConstraints percentWidth="20.0" />
        <ColumnConstraints percentWidth="20.0" />
        <ColumnConstraints percentWidth="20.0" />
      </columnConstraints>
      <children>
        <Label fx:id="score1" GridPane.columnIndex="0" GridPane.halignment="LEFT" />
        <Label fx:id="score2" GridPane.columnIndex="1" GridPane.halignment="CENTER" />
        <Button fx:id="newGameBtn" text="New Game" GridPane.columnIndex="2" GridPane.halignment="CENTER" />
        <Label fx:id="score3" GridPane.columnIndex="3" GridPane.halignment="CENTER" />
        <Label fx:id="score4" GridPane.columnIndex="4" GridPane.halignment="RIGHT" />
      </children>
    </GridPane>
  </children>
</VBox>